      <column caption='Forecast Price' datatype='real' default-format='c&quot;CAD &quot;#,##0.00' name='[Calculation_0798913490116623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] =&#10;    { FIXED [province], [product_name] :&#10;        MIN(&#10;            IF NOT ISNULL([pred_p50])&#10;            THEN [date]&#10;            END&#10;        )&#10;    }&#10;THEN [pred_p50]&#10;END' />
      </column>
      <column caption='Expected Change' datatype='real' default-format='p0.0%' name='[Calculation_0798913493913616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_0798913487736846]) != 0 THEN&#10;&#10;    (&#10;        AVG([Calculation_0798913490116623])&#10;        -&#10;        AVG([Calculation_0798913487736846])&#10;    )&#10;    /&#10;    AVG([Calculation_0798913487736846])&#10;&#10;END' />
      </column>
      <column caption='Forecast Change Price' datatype='real' default-format='c&quot;CAD &quot;#,##0.00' name='[Calculation_0798913494167569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0798913490116623])&#10;-&#10;AVG([Calculation_0798913487736846])' />
      </column>
      <column caption='Forecast Horizon' datatype='string' name='[Calculation_0798913494515730]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&#10;    DATENAME(&#10;        &apos;month&apos;,&#10;        { FIXED [province], [product_name] :&#10;            MIN(&#10;                IF NOT ISNULL([pred_p50])&#10;                THEN [date]&#10;                END&#10;            )&#10;        }&#10;    )&#10;)&#10;+ &quot; &quot;&#10;+&#10;STR(&#10;    DATEPART(&#10;        &apos;year&apos;,&#10;        { FIXED [province], [product_name] :&#10;            MIN(&#10;                IF NOT ISNULL([pred_p50])&#10;                THEN [date]&#10;                END&#10;            )&#10;        }&#10;    )&#10;)&#10;+&#10;&quot; – &quot; +&#10;STR(&#10;    DATENAME(&#10;        &apos;month&apos;,&#10;        { FIXED [province], [product_name] :&#10;            MAX(&#10;                IF NOT ISNULL([pred_p50])&#10;                THEN [date]&#10;                END&#10;            )&#10;        }&#10;    )&#10;)&#10;+&#10;&quot; &quot;&#10;+&#10;STR(&#10;    DATEPART(&#10;        &apos;year&apos;,&#10;        { FIXED [province], [product_name] :&#10;            MAX(&#10;                IF NOT ISNULL([pred_p50])&#10;                THEN [date]&#10;                END&#10;            )&#10;        }&#10;    )&#10;)' />
      </column>
